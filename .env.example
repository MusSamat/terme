# ─── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
BASE_URL=http://localhost:3000
# Mini App / Web client base for Telegram deep-link buttons (prod: https://app.terme.kg).
# Falls back to BASE_URL when unset.
MINI_APP_URL=

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kosho:kosho@localhost:5432/kosho?schema=public
# Separate DB for automated tests (docker-compose exposes it on 5433)
TEST_DATABASE_URL=postgresql://kosho:kosho@localhost:5433/kosho_test?schema=public

# ─── JWT ─────────────────────────────────────────────────────────────────
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-64-random-bytes-hex
JWT_REFRESH_SECRET=change-me-to-another-64-random-bytes-hex
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS_MOBILE=7
JWT_REFRESH_TTL_HOURS_WEB=24

# ─── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=terme_kg_bot
# Telegram Gateway (https://gateway.telegram.org) — OTP delivery over Telegram.
# Leave empty to capture/log codes locally instead of sending (testing period).
TELEGRAM_GATEWAY_TOKEN=

# Dexatel (https://dexatel.com) — SMS fallback for OTP when WhatsApp send fails
# (or when WhatsApp isn't configured). We generate + hash the code ourselves and
# Dexatel only delivers the SMS text. Leave DEXATEL_API_KEY empty to disable the
# fallback (dev/CI capture codes locally). In prod set EITHER WhatsApp OR Dexatel.
DEXATEL_API_KEY=
DEXATEL_SENDER=Terme

# ─── OAuth ──────────────────────────────────────────────────────────────
# Comma-separated if multiple clients (e.g. web + Flutter use different IDs)
GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=

# ─── SMS Provider (Mega.kg / Nikita) — DISABLED (Telegram-only period) ───
# OTP now goes via Telegram Gateway above; these are kept for later re-enable.
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_LOGIN=
SMS_API_PASSWORD=
SMS_SENDER=Terme

# ─── WhatsApp Cloud API (Meta) — inbox webhook + send ───────────────────
# From Meta App Dashboard → WhatsApp → API Setup, and App Settings → Basic.
WHATSAPP_PHONE_NUMBER_ID=          # "Phone number ID" (NOT the phone number)
WHATSAPP_ACCESS_TOKEN=             # System User permanent token (prod) / 24h test token
WHATSAPP_APP_SECRET=               # App Settings → Basic → App secret (verifies X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=             # any secret you invent; paste the SAME value into the dashboard
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=terme_otp    # approved auth template name (body param + copy-code URL button)
WHATSAPP_OTP_LANG=ru               # template language code (must exist in Meta)

# ─── Superadmin seed (first deploy only; then forces password change) ──
SUPERADMIN_EMAIL=superadmin@terme.kg
SUPERADMIN_TEMP_PASSWORD=change-on-first-login

# ─── File storage (MVP: local disk) ─────────────────────────────────────
FILES_DIR=./var/files
MAX_UPLOAD_MB=5

# ─── Backups (see docs/RESTORE.md) ──────────────────────────────────────
# No-op until BACKUP_DIR is set: db_backup / files_backup crons skip silently.
# Set on staging/prod to enable daily pg_dump (03:00) + rsync of FILES_DIR (04:00).
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

# ─── Sentry (error tracking) ────────────────────────────────────────────
# Empty = fully disabled (no init, captureException inert). Set the DSN on
# staging/prod to ship 5xx / uncaught errors to Sentry.
SENTRY_DSN=

# ─── Presence tunables (defaults match code) ────────────────────────────
PRESENCE_WINDOW_SEC=60
PRESENCE_THROTTLE_SEC=20
PRESENCE_CACHE_MS=10000

# ─── Rate limit overrides (for tests — defaults in code match TZ §7.3) ──
# RATE_LIMIT_DISABLED=false

# ─── Swagger ────────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
