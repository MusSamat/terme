// Popytchik.kg data model — matches TZ §5 (v2.0)
// Principles:
//   • UUID v4 PKs (gen_random_uuid())
//   • TIMESTAMPTZ everywhere (UTC)
//   • Soft delete via deleted_at (NULL = active)
//   • Indexes on FKs + hot filter fields
//   • Enums as string + CHECK via @db.VarChar + application-level validation
//     (Prisma enums would also work, but VARCHAR + CHECK keeps migrations simple
//      and allows backend to evolve values without `ALTER TYPE`)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────
model User {
  id               String    @id @default(uuid()) @db.Uuid
  telegramId       BigInt?   @unique @map("telegram_id")
  phone            String    @unique @db.VarChar(20)
  phoneVerifiedAt  DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  name             String    @db.VarChar(100)
  surname          String?   @db.VarChar(100)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(500)
  bio              String?   @db.VarChar(300)
  roles            String[]  @default(["passenger"])
  rating           Decimal   @default(0.00) @db.Decimal(3, 2)
  ratingCount      Int       @default(0) @map("rating_count")
  // Accumulated behavioural penalties (driver-cancel, no-show). Subtracted from
  // the average-of-recent-scores in recalcAverage so sanctions survive new
  // ratings (they used to be overwritten). Always ≥ 0; grows, never auto-decays.
  ratingPenalty    Decimal   @default(0.00) @map("rating_penalty") @db.Decimal(4, 2)
  language         String    @default("ru") @db.VarChar(2)
  // passenger | driver — what home leads with on every client (web, mobile, bot).
  preferredMode    String    @default("passenger") @map("preferred_mode") @db.VarChar(10)
  isBlocked        Boolean   @default(false) @map("is_blocked")
  blockedReason    String?   @map("blocked_reason")
  // Web sign-in only; mobile signs in by WhatsApp code. NULL = no password yet
  // (set it via the WhatsApp «forgot password» flow).
  passwordHash     String?   @map("password_hash") @db.VarChar(100)
  lastPasswordChangedAt DateTime? @map("last_password_changed_at") @db.Timestamptz(6)
  termsAcceptedAt  DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  loyaltyPoints    Int       @default(0) @map("loyalty_points")
  loyaltyTier      String    @default("novice") @map("loyalty_tier") @db.VarChar(20)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastPlatform     String?   @map("last_platform") @db.VarChar(10) // web | mobile — last presence ping origin
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  driverProfile       DriverProfile?
  tripsAsDriver       Trip[]          @relation("TripDriver")
  bookings            Booking[]       @relation("BookingPassenger")
  sentMessages        Message[]       @relation("MessageSender")
  ratingsGiven        Rating[]        @relation("RatingRater")
  ratingsReceived     Rating[]        @relation("RatingRatee")
  refreshTokens       RefreshToken[]
  notifications       Notification[]
  cars                Car[]
  complaintsReported  Complaint[]          @relation("ComplaintReporter")
  complaintsTargeting Complaint[]          @relation("ComplaintTargetUser")
  loyaltyTransactions LoyaltyTransaction[]
  passengerRequests     PassengerRequest[]
  requestResponses      PassengerRequestResponse[] @relation("RequestResponseDriver")
  listingLikes          ListingLike[]

  @@index([deletedAt])
  @@index([language])
  @@index([lastSeenAt]) // presence: online count = COUNT(last_seen_at >= now-60s)
  @@map("users")
}

// ─── Driver profiles ──────────────────────────────────────────────────
// verification_status: pending | verified | rejected | suspended | blocked
model DriverProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  carMake            String    @map("car_make") @db.VarChar(50)
  carModel           String    @map("car_model") @db.VarChar(50)
  carYear            Int       @map("car_year") @db.SmallInt
  carColor           String    @map("car_color") @db.VarChar(30)
  carPlate           String    @unique @map("car_plate") @db.VarChar(15)
  seatsCount         Int       @map("seats_count") @db.SmallInt
  // Existing columns keep their names and hold the FRONT side; the two
  // *_back columns were added later (nullable — legacy pre-2-side profiles).
  licensePhotoPath   String    @map("license_photo_path") @db.VarChar(500)
  licenseBackPath    String?   @map("license_back_path") @db.VarChar(500)
  carPassportPath    String    @map("car_passport_path") @db.VarChar(500)
  carPassportBackPath String?  @map("car_passport_back_path") @db.VarChar(500)
  carPhotoPath       String    @map("car_photo_path") @db.VarChar(500)
  selfiePath         String    @map("selfie_path") @db.VarChar(500)
  verificationStatus String    @default("pending") @map("verification_status") @db.VarChar(20)
  rejectionReason    String?   @map("rejection_reason")
  requestedDocs      String[]  @default([]) @map("requested_docs")
  submittedAt        DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  totalTrips         Int       @default(0) @map("total_trips")
  cancellations30d   Int       @default(0) @map("cancellations_30d")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `verifiedBy` references admins.id — but admins live in a separate table
  // from users, so we skip the FK and keep it a plain UUID. Admin identity for
  // audit is re-derivable from admin_actions.

  @@index([verificationStatus])
  @@map("driver_profiles")
}

// ─── Trips ────────────────────────────────────────────────────────────
// status: active | direct | completed | cancelled
//   direct = private ride created by accepting a passenger-request offer
model Trip {
  id                   String    @id @default(uuid()) @db.Uuid
  driverId             String    @map("driver_id") @db.Uuid
  // The car this trip rides on (Phase 1 multi-auto). Nullable for legacy trips
  // created before the cars table — their car falls back to driver_profiles.
  carId                String?   @map("car_id") @db.Uuid
  // intercity | airport (derived: an endpoint is an airport place). Airport
  // transfers skip the one-trip-per-route-per-day rule.
  kind                 String    @default("intercity") @db.VarChar(10)
  originCityId         Int       @map("origin_city_id")
  destinationCityId    Int       @map("destination_city_id")
  // Display snapshot of the place name (name_ru) — the ids are the truth.
  originCity           String    @map("origin_city") @db.VarChar(150)
  destinationCity      String    @map("destination_city") @db.VarChar(150)
  // Optional exact meeting points (map pin + note). NULL → the city itself.
  originAddress        String?   @map("origin_address") @db.VarChar(200)
  originLat            Float?    @map("origin_lat")
  originLng            Float?    @map("origin_lng")
  destinationAddress   String?   @map("destination_address") @db.VarChar(200)
  destinationLat       Float?    @map("destination_lat")
  destinationLng       Float?    @map("destination_lng")
  // Area of the pin inside Бишкек / Ош, derived server-side from lat/lng.
  originAreaId         Int?      @map("origin_area_id")
  destinationAreaId    Int?      @map("destination_area_id")
  departureAt          DateTime  @map("departure_at") @db.Timestamptz(6)
  departureFlexible    Boolean   @default(false) @map("departure_flexible")
  // «Выезд примерно 06:00–11:00»: departureAt = window start, this = window end.
  // NULL = exact departure time.
  departureWindowEnd   DateTime? @map("departure_window_end") @db.Timestamptz(6)
  estimatedDurationMin Int       @map("estimated_duration_min")
  seatsTotal           Int       @map("seats_total") @db.SmallInt
  seatsAvailable       Int       @map("seats_available") @db.SmallInt
  pricePerSeat         Int       @map("price_per_seat")
  priceNegotiable      Boolean   @default(false) @map("price_negotiable")
  luggage              String    @default("no") @db.VarChar(10)
  preferences          Json      @default("{}")
  comment              String?   @db.VarChar(300)
  status               String    @default("active") @db.VarChar(20)
  // Set exactly once when the trip transitions to a terminal completed state.
  // Drives the 48h post-trip phone-visibility window — decoupled from updatedAt,
  // which any view/like increment would otherwise keep bumping forever.
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledReason      String?   @map("cancelled_reason")
  idempotencyKey       String?   @unique @map("idempotency_key") @db.VarChar(100)
  viewsCount           Int       @default(0) @map("views_count")
  likesCount           Int       @default(0) @map("likes_count")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int       @default(1)

  driver      User       @relation("TripDriver", fields: [driverId], references: [id])
  car         Car?       @relation(fields: [carId], references: [id], onDelete: SetNull)
  origin      City       @relation("TripOrigin", fields: [originCityId], references: [id])
  destination City       @relation("TripDestination", fields: [destinationCityId], references: [id])
  originArea      CityArea? @relation("TripOriginArea", fields: [originAreaId], references: [id], onDelete: SetNull)
  destinationArea CityArea? @relation("TripDestinationArea", fields: [destinationAreaId], references: [id], onDelete: SetNull)
  stops       TripStop[]
  bookings    Booking[]
  ratings     Rating[]

  // Partial search / route-day unique indexes on the city ids live in raw SQL
  // (migration 20261018130000): idx_trips_active_search, idx_trips_active_destination,
  // idx_trips_route_day_unique.
  @@index([driverId])
  @@index([departureAt])
  @@index([carId])
  @@map("trips")
}

// Extra places on a trip's route: pickup = the driver can still board
// passengers there (origin side), dropoff = can drop them (destination side).
model TripStop {
  id       String @id @default(uuid()) @db.Uuid
  tripId   String @map("trip_id") @db.Uuid
  cityId   Int    @map("city_id")
  kind     String @db.VarChar(10) // pickup | dropoff
  position Int    @db.SmallInt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id])

  @@unique([tripId, kind, cityId], map: "trip_stops_trip_kind_city_key")
  @@index([cityId, kind])
  @@map("trip_stops")
}

// ─── Bookings ─────────────────────────────────────────────────────────
// status: pending | viewed | accepted | rejected | cancelled_by_passenger | cancelled_by_driver
//       | cancelled_late | no_show | completed | expired
// viewed: driver saw the request (§11 booking:viewed event)
// cancelled_by: driver | passenger
model Booking {
  id          String    @id @default(uuid()) @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  passengerId String    @map("passenger_id") @db.Uuid
  seatsCount  Int       @map("seats_count") @db.SmallInt
  comment     String?   @db.VarChar(300)
  // Price per seat frozen at booking time so a driver raising trip.pricePerSeat
  // after acceptance can't silently change what the passenger agreed to pay.
  pricePerSeatSnapshot Int? @map("price_per_seat_snapshot")
  status      String    @default("pending") @db.VarChar(25)
  cancelledBy      String?   @map("cancelled_by") @db.VarChar(10)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReasons    String[]  @map("cancel_reasons") @default([])
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  viewedAt    DateTime? @map("viewed_at") @db.Timestamptz(6)
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip      Trip      @relation(fields: [tripId], references: [id])
  passenger User      @relation("BookingPassenger", fields: [passengerId], references: [id])
  messages  Message[]

  @@index([tripId])
  @@index([passengerId])
  @@index([status])
  @@index([expiresAt])
  // The partial UNIQUE on (trip_id, passenger_id) WHERE status IN (pending, accepted)
  // is added via raw SQL in the initial migration (Prisma doesn't support partial
  // indexes in the schema DSL).
  @@map("bookings")
}

// ─── Messages (chat) ──────────────────────────────────────────────────
// chat_phase: pre_booking (pending booking) | full (accepted+)
// is_filtered: text contained phone/URL that was scrubbed
// original_text: preserved for audit only — never exposed to clients
model Message {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  senderId     String    @map("sender_id") @db.Uuid
  text         String    @db.VarChar(2000)
  chatPhase    String    @default("full") @map("chat_phase") @db.VarChar(20)
  isFiltered   Boolean   @default(false) @map("is_filtered")
  originalText String?   @map("original_text") @db.VarChar(2000)
  isRead       Boolean   @default(false) @map("is_read")
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id])

  @@index([bookingId])
  @@index([createdAt])
  @@map("messages")
}

// ─── Ratings ──────────────────────────────────────────────────────────
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  score     Int      @db.SmallInt
  tags      String[] @default([])
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip  Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rater User @relation("RatingRater", fields: [raterId], references: [id])
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id])

  @@unique([tripId, raterId, rateeId])
  @@index([rateeId])
  // Spam guard counts prior ratings by the same rater+comment — raterId must lead.
  @@index([raterId])
  @@map("ratings")
}

// ─── Notifications ────────────────────────────────────────────────────
// channel: telegram | push | both
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  channel   String    @db.VarChar(10)
  payload   Json
  delivered Boolean   @default(false)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([delivered])
  // List query: WHERE user_id ORDER BY created_at DESC (cursor pagination).
  @@index([userId, createdAt(sort: Desc)])
  // Unread badge: WHERE user_id AND read_at IS NULL.
  @@index([userId, readAt])
  @@map("notifications")
}

// ─── Complaints ───────────────────────────────────────────────────────
// category: safety | fraud | rudeness | no_show | other
// status: new | in_review | resolved | dismissed
model Complaint {
  id             String    @id @default(uuid()) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  targetUserId   String?   @map("target_user_id") @db.Uuid
  targetTripId   String?   @map("target_trip_id") @db.Uuid
  category       String    @db.VarChar(50)
  description    String
  attachments    String[]  @default([])
  status         String    @default("new") @db.VarChar(20)
  escalatedAt    DateTime? @map("escalated_at") @db.Timestamptz(6)
  resolution     String?
  handledBy      String?   @map("handled_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  reporter   User  @relation("ComplaintReporter", fields: [reporterId], references: [id])
  targetUser User? @relation("ComplaintTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  // handledBy is an admin id — admins live in their own table so we skip the FK.

  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

// ─── OTP codes ────────────────────────────────────────────────────────
model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String    @db.VarChar(20)
  codeHash  String    @map("code_hash") @db.VarChar(100)
  attempts  Int       @default(0) @db.SmallInt
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  // M5: requester IP (NULL for bot-initiated sends) — daily cap is per (phone, ip).
  requestIp String?   @map("request_ip") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@index([createdAt]) // H1: global / foreign daily OTP budget counts
  @@map("otp_codes")
}

// ─── Refresh tokens ───────────────────────────────────────────────────
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(100)
  deviceInfo String?   @map("device_info") @db.VarChar(300)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  // usedAt: flipped on /auth/refresh. Presenting a token with used_at IS NOT
  // NULL a second time is the Token Reuse Detection trigger (TZ v2.1 §7.5).
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  // H4: token family = one login; rotations inherit it. Reuse detection
  // revokes the family only. replacedById = the token this one rotated into.
  familyId     String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Settlements directory (official SOATE 2026) ──────────────────────
// Tree: oblast → raion → aiyl_aimak → village; capital (Бишкек, Ош) and city
// (oblast-significance) sit under an oblast, town under a raion. oblast_id /
// raion_id are denormalized ancestors for display and "nearby" lookups.
// Built by scripts/cities/build-cities.py; soate_code is the stable key.
// Raw-SQL extras (migration 20261018130000): kg_fold() generated *_folded
// columns + pg_trgm GIN indexes for autocomplete, cities_lat_lng_idx.
model City {
  id           Int      @id @default(autoincrement())
  // SOATE code; "osm:<id>" for villages SOATE does not list separately (Бостери).
  soateCode    String   @unique @map("soate_code") @db.VarChar(20)
  // oblast | capital | city_district | raion | city | town | aiyl_aimak | village | airport
  type         String   @db.VarChar(20)
  parentId     Int?     @map("parent_id")
  oblastId     Int?     @map("oblast_id")
  raionId      Int?     @map("raion_id")
  nameRu       String   @map("name_ru") @db.VarChar(150)
  nameKg       String   @map("name_kg") @db.VarChar(150)
  // Alternative spellings / former names used by search (e.g. «Жалал-Абад» → Манас).
  aliases      String[] @default([])
  lat          Float?
  lng          Float?
  // true = no exact point known, lat/lng is the aiyl aimak centroid.
  coordApprox  Boolean  @default(false) @map("coord_approx")
  osmType      String?  @map("osm_type") @db.VarChar(10)
  osmId        BigInt?  @map("osm_id")
  priority     Int      @default(0)
  isSearchable Boolean  @default(true) @map("is_searchable")
  isActive     Boolean  @default(true) @map("is_active")

  parent   City?  @relation("CityTree", fields: [parentId], references: [id], onDelete: SetNull)
  children City[] @relation("CityTree")
  oblast   City?  @relation("CityOblast", fields: [oblastId], references: [id], onDelete: SetNull)
  oblastOf City[] @relation("CityOblast")
  raion    City?  @relation("CityRaion", fields: [raionId], references: [id], onDelete: SetNull)
  raionOf  City[] @relation("CityRaion")

  areas        CityArea[]
  tripsFrom    Trip[]             @relation("TripOrigin")
  tripsTo      Trip[]             @relation("TripDestination")
  tripStops    TripStop[]
  requestsFrom PassengerRequest[] @relation("RequestOrigin")
  requestsTo   PassengerRequest[] @relation("RequestDestination")

  @@index([parentId])
  @@index([raionId])
  @@map("cities")
}

// Жилмассивы / микрорайоны of Бишкек and Ош (scripts/cities/build-areas.py).
// Label meeting-point pins («Бишкек · Асанбай») and power the pin search.
model CityArea {
  id      Int     @id @default(autoincrement())
  cityId  Int     @map("city_id")
  nameRu  String  @map("name_ru") @db.VarChar(150)
  nameKg  String  @map("name_kg") @db.VarChar(150)
  lat     Float
  lng     Float
  osmType String? @map("osm_type") @db.VarChar(10)
  osmId   BigInt? @map("osm_id")

  city             City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripOrigins      Trip[]             @relation("TripOriginArea")
  tripDestinations Trip[]             @relation("TripDestinationArea")
  requestOrigins   PassengerRequest[] @relation("RequestOriginArea")
  requestDestinations PassengerRequest[] @relation("RequestDestinationArea")

  @@index([cityId])
  @@map("city_areas")
}

// ─── Admins (separate from users) ─────────────────────────────────────
// role: admin | superadmin
model Admin {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(200)
  passwordHash      String    @map("password_hash") @db.VarChar(100)
  name              String    @db.VarChar(100)
  role              String    @default("admin") @db.VarChar(20)
  // Legacy plaintext secret — migrated lazily into totp_secret_enc on the next
  // successful TOTP login, then nulled. New secrets never land here.
  totpSecret        String?   @map("totp_secret") @db.VarChar(200)
  // H2: AES-256-GCM encrypted (lib/secretBox, key TOTP_ENC_KEY).
  totpSecretEnc     String?   @map("totp_secret_enc") @db.VarChar(300)
  totpPendingEnc    String?   @map("totp_pending_enc") @db.VarChar(300)
  // Last accepted 30s time-step — a code is accepted once (replay guard).
  totpLastStep      Int?      @map("totp_last_step")
  totpEnabled       Boolean   @default(false) @map("totp_enabled")
  // M6: bumped on logout / password change / TOTP change; admin refresh JWTs
  // carry it and are rejected when stale.
  tokenEpoch        Int       @default(0) @map("token_epoch")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  actions AdminAction[]

  @@map("admins")
}

// ─── Cars (Phase 1: publish without verification) ─────────────────────
// A user owns any number of cars; a trip references the one it rides on.
// Verification stays on DriverProfile as an OPTIONAL badge — it no longer
// gates publishing.
model Car {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  make       String    @db.VarChar(50)
  model      String    @db.VarChar(50)
  color      String?   @db.VarChar(30)
  year       Int?      @db.SmallInt
  plate      String    @db.VarChar(15)
  seatsCount Int       @default(4) @map("seats_count") @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([userId])
  @@map("cars")
}

// ─── Car catalog (brands → models) ────────────────────────────────────
// Reference data powering the make/model pickers when adding/editing a car.
// Small, cached in memory; admin-editable CRUD. Ids are stable SMALLINTs so
// the seed is idempotent and re-runnable.
model CarBrand {
  id           Int        @id @db.SmallInt
  name         String     @unique @db.VarChar(50)
  sortPosition Int        @map("sort_position") @db.SmallInt
  isActive     Boolean    @default(true) @map("is_active")
  models       CarModel[]

  @@index([isActive, sortPosition])
  @@map("car_brands")
}

model CarModel {
  id           Int      @id @db.SmallInt
  brandId      Int      @map("brand_id") @db.SmallInt
  name         String   @db.VarChar(100)
  bodyType     String?  @map("body_type") @db.VarChar(20) // sedan|suv|hatchback|mpv|pickup|van|truck
  sortPosition Int      @map("sort_position") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  brand        CarBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, sortPosition])
  @@map("car_models")
}

model CarColor {
  id           Int     @id @db.SmallInt
  nameRu       String  @map("name_ru") @db.VarChar(50)
  nameKy       String  @map("name_ky") @db.VarChar(50)
  hexCode      String  @map("hex_code") @db.VarChar(9)
  sortPosition Int     @map("sort_position") @db.SmallInt
  isActive     Boolean @default(true) @map("is_active")

  @@index([isActive, sortPosition])
  @@map("car_colors")
}

// ─── Phone-reveal audit («Позвонить» taps) ────────────────────────────
// Every reveal of a user's phone number is logged: who saw whose number,
// in which context (trip / passenger_request). Powers the daily rate limit
// (anti-scraping) and abuse investigations. Plain UUIDs (AdminAction style).
model ContactReveal {
  id           String   @id @default(uuid()) @db.Uuid
  viewerId     String   @map("viewer_id") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  contextType  String   @map("context_type") @db.VarChar(30) // trip | passenger_request
  contextId    String   @map("context_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([viewerId, contextType, contextId])
  @@index([viewerId, createdAt])
  @@index([targetUserId])
  // Reveal-count per listing (trip/request details, myTrips groupBy) queries by
  // (contextType, contextId) — viewerId-led indexes don't cover it.
  @@index([contextType, contextId])
  @@map("contact_reveals")
}

// ─── Admin actions audit log ──────────────────────────────────────────
model AdminAction {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  targetType String?  @map("target_type") @db.VarChar(30)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_actions")
}

// ─── Loyalty program (§Этап 3) ───────────────────────────────────────
// Tiers: novice (0-99) | traveler (100-299) | expert (300-599) | elite (600+)
// source: trip_completed | bonus | manual
model LoyaltyTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int
  source    String   @db.VarChar(30)
  tripId    String?  @map("trip_id") @db.Uuid
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotent per-trip awards: (user, trip, source) can exist at most once, so a
  // race between manual complete() and the auto_complete cron can't double-award.
  // NULL tripId (bonus/manual) is exempt — Postgres treats NULLs as distinct.
  @@unique([userId, tripId, source])
  @@index([userId])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

// ─── Analytics snapshot (written by analytics_recalc cron) ───────────
model AnalyticsSnapshot {
  key       String   @id @db.VarChar(50)
  data      Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("analytics_snapshots")
}

// ─── Cron locks (prevents double-run across instances) ───────────────
model CronLock {
  jobName     String   @id @map("job_name") @db.VarChar(100)
  lockedAt    DateTime @map("locked_at") @db.Timestamptz(6)
  lockedUntil DateTime @map("locked_until") @db.Timestamptz(6)
  lockedBy    String   @map("locked_by") @db.VarChar(100)

  @@map("cron_locks")
}

// ─── Passenger requests ───────────────────────────────────────────────
// Passengers post "I need N seats from A to B on date" — drivers browse.
// status: open | cancelled | expired
model PassengerRequest {
  id              String    @id @default(uuid()) @db.Uuid
  passengerId     String    @map("passenger_id") @db.Uuid
  kind            String    @default("intercity") @db.VarChar(10) // intercity | airport
  // Arriving / departing flight («SU 1882») so the driver can meet the passenger.
  flightNumber    String?   @map("flight_number") @db.VarChar(10)
  // Airport requests only: meet at arrivals with a name sign; luggage pieces
  // 0–5 (CHECK in migration 20261019140000), NULL = not said.
  meetWithSign    Boolean   @default(false) @map("meet_with_sign")
  luggageCount    Int?      @map("luggage_count") @db.SmallInt
  originCityId    Int       @map("origin_city_id")
  destinationCityId Int     @map("destination_city_id")
  // Display snapshot of the place name (name_ru) — the ids are the truth.
  originCity      String    @map("origin_city") @db.VarChar(150)
  destinationCity String    @map("destination_city") @db.VarChar(150)
  // Optional exact pickup / drop-off points (map pin + note).
  originAddress   String?   @map("origin_address") @db.VarChar(200)
  originLat       Float?    @map("origin_lat")
  originLng       Float?    @map("origin_lng")
  destinationAddress String? @map("destination_address") @db.VarChar(200)
  destinationLat  Float?    @map("destination_lat")
  destinationLng  Float?    @map("destination_lng")
  originAreaId    Int?      @map("origin_area_id")
  destinationAreaId Int?    @map("destination_area_id")
  seatsNeeded     Int       @default(1) @map("seats_needed") @db.SmallInt
  departureDate   DateTime  @map("departure_date") @db.Timestamptz(6)
  flexible        Boolean   @default(false)
  comment         String?   @db.VarChar(500)
  status          String    @default("open") @db.VarChar(20)
  viewsCount      Int       @default(0) @map("views_count")
  likesCount      Int       @default(0) @map("likes_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  passenger   User                       @relation(fields: [passengerId], references: [id])
  origin      City                       @relation("RequestOrigin", fields: [originCityId], references: [id])
  destination City                       @relation("RequestDestination", fields: [destinationCityId], references: [id])
  originArea      CityArea?              @relation("RequestOriginArea", fields: [originAreaId], references: [id], onDelete: SetNull)
  destinationArea CityArea?              @relation("RequestDestinationArea", fields: [destinationAreaId], references: [id], onDelete: SetNull)
  responses   PassengerRequestResponse[]

  // idx_requests_open_search / idx_requests_open_destination /
  // idx_requests_route_day_unique: raw SQL (migration 20261018130000).
  @@index([status, departureDate])
  @@index([passengerId])
  @@map("passenger_requests")
}

// ─── Passenger request responses ─────────────────────────────────────
// Driver responds with a price + departure time offer.
// status: pending | accepted | declined | expired
model PassengerRequestResponse {
  id            String    @id @default(uuid()) @db.Uuid
  requestId     String    @map("request_id") @db.Uuid
  driverId      String    @map("driver_id") @db.Uuid
  price         Int
  departureTime DateTime  @map("departure_time") @db.Timestamptz(6)
  message       String?   @db.VarChar(500)
  status        String    @default("pending") @db.VarChar(20)
  bookingId     String?   @unique @map("booking_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request PassengerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  driver  User             @relation("RequestResponseDriver", fields: [driverId], references: [id])

  @@unique([requestId, driverId])
  @@index([requestId])
  @@index([driverId])
  @@index([expiresAt])
  @@map("passenger_request_responses")
}

// ─── Listing likes (polymorphic: trips + passenger requests) ─────────
// target_type: 'trip' | 'passenger_request'. Polymorphic by design (no FK on
// target_id) so one table serves both listing kinds — denormalized likes_count
// lives on the target row for cheap reads. UNIQUE(target,user) makes like a toggle.
model ListingLike {
  id         String   @id @default(uuid()) @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("listing_likes")
}

// ─── Listing views (polymorphic, deduped per unique viewer) ──────────
// One row per (listing, viewer) — UNIQUE makes views_count count unique people,
// not refreshes. viewer_key = "u:<userId>" (authenticated) or "a:<anonId>"
// (anonymous client session). Owner self-views are never recorded.
model ListingView {
  id         String   @id @default(uuid()) @db.Uuid
  targetType String   @map("target_type") @db.VarChar(20)
  targetId   String   @map("target_id") @db.Uuid
  viewerKey  String   @map("viewer_key") @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([targetType, targetId, viewerKey])
  @@index([targetType, targetId])
  @@map("listing_views")
}

// ─── Telegram bot conversation state ─────────────────────────────────
// One row per chat: the current step of a multi-step flow + its draft data.
model BotSession {
  telegramId BigInt   @id @map("telegram_id")
  state      String?  @db.VarChar(40)
  data       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt])
  @@map("bot_sessions")
}

// ─── WhatsApp inbox (Cloud API) ───────────────────────────────────────
// Minimal inbox over the WhatsApp Cloud API: one conversation per customer
// phone number, an ordered message log per conversation. direction/status are
// VARCHAR (not Prisma enums) to match this schema's enum-as-string convention.
//   direction: INBOUND | OUTBOUND
//   status:    SENT | DELIVERED | READ | FAILED  (OUTBOUND only; NULL otherwise)
model WhatsappConversation {
  id            String   @id @default(uuid()) @db.Uuid
  phoneNumber   String   @unique @map("phone_number") @db.VarChar(20)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  messages WhatsappMessage[]

  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  direction         String   @db.VarChar(10)
  body              String   @db.Text
  status            String?  @db.VarChar(10)
  // wamid from Meta — unique so status updates match a row and redelivered
  // inbound webhooks don't insert duplicates.
  whatsappMessageId String?  @unique @map("whatsapp_message_id") @db.VarChar(128)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("whatsapp_messages")
}
